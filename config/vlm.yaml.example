# VLM 設定（llama.cpp / llama-server）
# コピー: cp config/vlm.yaml.example config/vlm.yaml

base_url: http://127.0.0.1:8081/v1
model: /opt/llama.cpp/models/Qwen3.6-35B-A3B-uncensored-heretic-APEX-I-Compact.gguf

max_tokens: 1536
max_flat_tags: 60
temperature: 0.1
max_image_size: 768
jpeg_quality: 85
enable_thinking: false
# 試行錯誤用: think モード（遅いが namespace/同義判断が安定しやすい）
# enable_thinking: true
# thinking_budget_tokens: 256   # llama-server の推論トークン上限
# max_thinking_chars: 400        # プロンプト上の文字数目安
timeout_seconds: 180
