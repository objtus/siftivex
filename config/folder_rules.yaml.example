# 取り込みプロファイル
# コピー: cp config/folder_rules.yaml.example config/folder_rules.yaml
# path_prefix は config/paths.yaml の server パスと一致させる

profiles:
  under_iphone:
    route_tag: route/under-iphone
    parser: under_iphone_legacy_v1
    ocr_engine: paddle
    fixed_tags: []

  pixiv_bookmarks:
    route_tag: route/pixiv
    metadata: pixiv_hybrid       # sidecar 優先 → pixiv_filename.py
    ocr_engine: manga
    fixed_tags: []

  icloud_photos:
    route_tag: route/icloud
    parser: null
    fixed_tags: []

rules:
  - path_prefix: /srv/siftivex-archive/under.iphone
    profile: under_iphone

  - path_prefix: /srv/siftivex-archive/pixiv
    profile: pixiv_bookmarks

  # - path_prefix: /srv/siftivex-archive/icloud-photos
  #   profile: icloud_photos
